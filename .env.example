# Fireworks AI (OpenAI-compatible chat + vision)
# Docs: https://docs.fireworks.ai — endpoint matches OpenAI SDK / LangChain ChatOpenAI.
FIREWORKS_API_KEY=...
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1/
# Chat / agents. Fireworks retires serverless ids periodically — if you get
# "404 Model not found", run scripts/fireworks_probe_models.py to list what your key can reach.
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6
# Multimodal model for PDF vision ingest AND imaging draft radiology reports.
# Must accept image_url content blocks on your account (often different from chat-only models).
FIREWORKS_VL_MODEL=accounts/fireworks/models/kimi-k2p6
# Qwen3-style models may put CoT in reasoning_content; ``none`` keeps answers in message content.
FIREWORKS_REASONING_EFFORT=none
# PDF vision transport: chat = /v1/chat/completions (works with kimi-k2p6). completions = /v1/completions + <image> (Qwen-style).
FIREWORKS_VLM_API=chat
# FIREWORKS_VLM_COMPLETIONS_TIMEOUT=120

# Optional caps for vision ingest (defaults shown)
# PDF_VL_MAX_PAGES=25
# PDF_VL_DPI=150

ZEP_API_KEY=...

# Apply the clinical ontology to Zep at API startup (project-wide). Set false to skip automatic
# registration; re-apply manually with scripts/apply_ontology.py.
AUTO_APPLY_ZEP_ONTOLOGY=true

# FastAPI service that backs the React Frontend (apps/api/main.py).
# Comma-separated list of allowed browser origins for CORS.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Langtrace (optional) — traces LangChain + LangGraph / Deep Agents; get a key at https://langtrace.ai
# LANGTRACE_API_KEY=
# LANGTRACE_SERVICE_NAME=medtrace-agent
# LANGTRACE_API_HOST=              # self-hosted only; default https://langtrace.ai/

# LangSmith (https://smith.langchain.com) — alternative to Langtrace.
# Auto-instruments LangChain / LangGraph / Deep Agents when these are set; no code change required.
# Get a key at: https://smith.langchain.com/settings → API Keys → Create
# Do not enable both LangSmith and Langtrace unless you want dual-export.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medtrace-agent
# Legacy alias kept for LangChain < 0.3 and a few community packages.
LANGCHAIN_TRACING_V2=true

# PubMed E-utilities (optional; used by Clinical reasoning Deep Agent)
# NCBI recommends setting your email; optional API key increases rate limits.
# NCBI_EMAIL=you@example.com
# NCBI_API_KEY=...

# ── Canonical clinical store: self-hosted Medplum FHIR R4 ───────────────────
# Start the local stack with `npm run medplum:up`, open http://localhost:3002,
# create a project ClientApplication, and keep its secret backend-only here.
#
# Local UI login (demo only):
#   admin@example.com / medplum_admin          (Medplum default super-admin)
#   dev@medtrace.local / medtrace-dev          (`npm run medplum:dev-account`)
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
# MEDPLUM_TIMEOUT_SECONDS=30
# MEDTRACE_IDENTIFIER_BASE=https://medtrace.local/fhir/identifier

# ── Voice session (/session route, services/transcription) ────────────────────
# 1. Transcription (Nova) + spoken replies (Aura) -> Deepgram. REQUIRED for
#    recording/upload STT; TTS is skipped without a key. Get one at
#    https://console.deepgram.com/
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# Used by /session and the YC demo diarization path:
# Current batch diarizer values: latest, v1, or v2. Do not also send deprecated diarize=true.
DEEPGRAM_DIARIZE_MODEL=latest
# YC demo also reads DEEPGRAM_MODEL / DEEPGRAM_LANGUAGE (prerecorded STT):
# DEEPGRAM_MODEL=
# DEEPGRAM_LANGUAGE=en
# Optional for synthetic demo audio; review Deepgram pricing before opting out.
# DEEPGRAM_MIP_OPT_OUT=true
# DEEPGRAM_TIMEOUT_SECONDS=90
#
# 2. OpenAI-compatible chat for the session report agent + dashboard collab agent.
# The YC demo uses Responses structured outputs; choose a compatible model.
# Leave OPENAI_BASE_URL empty for the official OpenAI API (or point at Fireworks).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# -- YC Medplum hackathon demo (real providers only) --------------------------
# The route is /yc-medplum-hackathon-demo. This is the canonical Medplum Patient.id
# printed by scripts/provision_yc_demo_patient.py.
YC_DEMO_PATIENT_ID=
# At least 32 characters. Used only to bind approval requests to provider-produced evidence.
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(32))"
YC_DEMO_CHECKIN_SIGNING_KEY=
# Generate a second, different secret. The operator pastes this at runtime; it is never a Vite variable.
YC_DEMO_ACCESS_TOKEN=
# Server-owned approval provenance; the browser cannot override either value.
YC_DEMO_OPERATOR_ID=
YC_DEMO_OPERATOR_NAME=

# Moss local session retrieval. The code does not call push_index().
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=
MOSS_MODEL_ID=
MOSS_QUERY_TOP_K=5
MOSS_QUERY_ALPHA=0.8
# MOSS_TIMEOUT_SECONDS=30
MOSS_DISABLE_TELEMETRY=1

# Stedi constrained test mode. Use exact supported synthetic test values only.
# A test-mode key is deliberately separate from any production credential.
STEDI_TEST_API_KEY=
STEDI_TRADING_PARTNER_SERVICE_ID=60054
STEDI_PROVIDER_ORGANIZATION_NAME=Provider Name
STEDI_PROVIDER_NPI=1999999984
STEDI_SUBSCRIBER_MEMBER_ID=AETNA12345
STEDI_SUBSCRIBER_FIRST_NAME=Jane
STEDI_SUBSCRIBER_LAST_NAME=Doe
STEDI_SUBSCRIBER_DATE_OF_BIRTH=20040404
STEDI_SERVICE_TYPE_CODES=30
# STEDI_TIMEOUT_SECONDS=45

# ── Imaging: MedSAM2 3D segmentation server (optional) ────────────────────────
# A deployed MedSAM2 (https://medsam2.github.io/) inference gateway. Without these
# the segmentation routes fall back to a deterministic mock ellipsoid.
# Point at the GATEWAY base (the FastAPI proxy, default port 8080) — the backend
# appends /v1/medsam2/segment/3d. Do NOT use the Gradio test UI on port 7860; that
# is a browser UI, not an API, and requests to it 404.
#   MEDSAM2_ENDPOINT=http://<host>:8080
MEDSAM2_ENDPOINT=
MEDSAM2_API_KEY=
# Volume inference is slow; seconds before the HTTP call gives up.
# MEDSAM2_TIMEOUT_S=300
# Draft radiology reports use FIREWORKS_API_KEY + FIREWORKS_VL_MODEL (see top).
# Optional Medplum admin app URL used for "Open in Medplum" links in the web UI.
VITE_MEDPLUM_APP_URL=http://localhost:3002

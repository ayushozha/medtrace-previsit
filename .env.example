# Fireworks AI (OpenAI-compatible chat + vision)
# Docs: https://docs.fireworks.ai — endpoint matches OpenAI SDK / LangChain ChatOpenAI.
FIREWORKS_API_KEY=...
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1/
# Chat / agents. Fireworks retires serverless ids periodically — if you get
# "404 Model not found", run scripts/fireworks_probe_models.py to list what your key can reach.
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6
# PDF vision ingest — must be multimodal on your account (often different from chat-only models).
FIREWORKS_VL_MODEL=accounts/fireworks/models/kimi-k2p6
# Qwen3-style models may put CoT in reasoning_content; ``none`` keeps answers in message content.
FIREWORKS_REASONING_EFFORT=none
# PDF vision transport: chat = /v1/chat/completions (works with kimi-k2p6). completions = /v1/completions + <image> (Qwen-style).
FIREWORKS_VLM_API=chat
# FIREWORKS_VLM_COMPLETIONS_TIMEOUT=120

# Optional caps for vision ingest (defaults shown)
# PDF_VL_MAX_PAGES=25
# PDF_VL_DPI=150

ZEP_API_KEY=...

# Apply the clinical ontology to Zep at API startup (project-wide). Set false to skip automatic
# registration; re-apply manually with scripts/apply_ontology.py.
AUTO_APPLY_ZEP_ONTOLOGY=true

# FastAPI service that backs the React Frontend (apps/api/main.py).
# Comma-separated list of allowed browser origins for CORS.
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Langtrace (optional) — traces LangChain + LangGraph / Deep Agents; get a key at https://langtrace.ai
# LANGTRACE_API_KEY=
# LANGTRACE_SERVICE_NAME=medtrace-agent
# LANGTRACE_API_HOST=              # self-hosted only; default https://langtrace.ai/

# LangSmith (https://smith.langchain.com) — alternative to Langtrace.
# Auto-instruments LangChain / LangGraph / Deep Agents when these are set; no code change required.
# Get a key at: https://smith.langchain.com/settings → API Keys → Create
# Do not enable both LangSmith and Langtrace unless you want dual-export.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medtrace-agent
# Legacy alias kept for LangChain < 0.3 and a few community packages.
LANGCHAIN_TRACING_V2=true

# PubMed E-utilities (optional; used by Clinical reasoning Deep Agent)
# NCBI recommends setting your email; optional API key increases rate limits.
# NCBI_EMAIL=you@example.com
# NCBI_API_KEY=...

# ── Canonical clinical store: self-hosted Medplum FHIR R4 ───────────────────
# Start the local stack with `npm run medplum:up`, open http://localhost:3002,
# create a project ClientApplication, and keep its secret backend-only here.
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
MEDPLUM_PROJECT_ID=
# MEDPLUM_TIMEOUT_SECONDS=30
# MEDTRACE_IDENTIFIER_BASE=https://medtrace.local/fhir/identifier

# ── Voice session (/session route, services/transcription) ────────────────────
# Three different credentials, used by three different steps:
#
# 1. Transcription + speaker diarization -> Google Gemini 2.5 Flash. REQUIRED for
#    recording/upload to work. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
#
# 2. The report-writing agent -> any OpenAI-compatible chat endpoint. You can point
#    this at Fireworks and reuse the key above instead of buying an OpenAI plan:
#      OPENAI_API_KEY=<your FIREWORKS_API_KEY>
#      OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
#      OPENAI_MODEL=accounts/fireworks/models/kimi-k2p6
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
#
# 3. Spoken replies (tts-1) -> genuine OpenAI only. Optional: without OPENAI_API_KEY
#    pointing at api.openai.com, transcript and report still work, just no audio out.

# Vite injects VITE_* env vars into the browser bundle.
# Copy this file to `.env.local` and override only what you need.

# Medtrace API — clinical routes (/api/patients, /api/threads) and imaging routes
# (/api/studies) are served by the same app. Vite proxies /api and /data to it, so leave
# this empty to stay same-origin; set it only when the API is on another origin.
# VITE_API_BASE_URL=""

# Where Vite forwards /api and /data during dev. IPv4 literal on purpose: the API binds
# 127.0.0.1, and `localhost` resolves to ::1 first on macOS.
# VITE_API_PROXY_TARGET="http://127.0.0.1:8001"

# Transcription service — a separate process on its own port, started by
# `npm run dev:transcription`. Only the /session route uses it.
VITE_TRANSCRIPTION_API_URL="http://localhost:8010"

# The /session route proxies /api/copilotkit to the CopilotKit runtime (an Express
# server started by the same script). Override only if it is not on :4000.
# COPILOTKIT_URL="http://localhost:4000"

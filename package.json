{
  "name": "medtrace-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "One FastAPI service (clinical + imaging) and one web app, plus the transcription prototype.",
  "scripts": {
    "dev": "concurrently -k -n api,web,zep-sync -c magenta,green,cyan \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:zep-sync\"",
    "dev:api": "python -m uvicorn apps.api.main:app --host 127.0.0.1 --port 8001 --reload",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:zep-sync": "python scripts/medplum_zep_worker.py",
    "medplum:up": "docker compose -f infra/medplum/docker-compose.yml up -d",
    "medplum:down": "docker compose -f infra/medplum/docker-compose.yml down",
    "medplum:logs": "docker compose -f infra/medplum/docker-compose.yml logs -f medplum-server medplum-app",
    "medplum:bootstrap": "python scripts/medplum_bootstrap.py",
    "medplum:seed": "python scripts/seed_medplum.py",
    "dev:transcription": "concurrently -k -n tr-api,tr-copilot -c yellow,red \"npm:dev:transcription-api\" \"npm:dev:transcription-copilot\"",
    "dev:transcription-api": "python -m uvicorn main:app --app-dir services/transcription/backend --host 127.0.0.1 --port 8010 --reload",
    "dev:transcription-copilot": "npm --prefix services/transcription/copilotkit-server run dev",
    "lint": "npm --prefix apps/web run lint",
    "build": "npm --prefix apps/web run build",
    "test:py": "python -m pytest -m \"not integration\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
